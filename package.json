{ "name": "cortesiatv-apk", "private": true, "scripts": { "prepare-www": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});for(const f of ['index.html','anime.html','player.html','catalogo.html','manifest.webmanifest','css','js','data','assets','animes'])fs.cpSync(f,'www/'+f,{recursive:true})\"", "sync": "npm run prepare-www && npx cap sync android" }, "devDependencies": { "@capacitor/cli": "^6.0.0", "@capacitor/core": "^6.0.0", "@capacitor/android": "^6.0.0" } }
